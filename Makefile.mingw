# MinGW Makefile for CgePix

CC = gcc
AR = ar
CFLAGS = -std=c99 -O2 -Wall -Wextra
ARFLAGS = rcs
TARGET = libCgePix.a

SOURCES = Color.c Pix.c
OBJECTS = $(SOURCES:.c=.o)

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(AR) $(ARFLAGS) $@ $^

%.o: %.c CgePix.h
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	del $(OBJECTS) $(TARGET) 2>nul || exit 0
